# 统一换行符：仓库内一律 LF，检出时也不转换
# 避免 Windows / macOS / Linux 协作时产生整文件 diff
* text=auto eol=lf

# Windows 脚本必须 CRLF，否则 cmd.exe 解析会出问题
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.avif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.mp4 binary
*.webm binary
*.zip binary

# lockfile 在 GitHub 上折叠显示（本地 git diff 仍可查看内容）
package-lock.json linguist-generated
